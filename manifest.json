{
  "manifest_version": 3,
  "name": "Hotel Number Four - Booking Assistant",
  "version": "1.4.2",
  "description": "Cross-reference NewBook hotel bookings with restaurant reservations",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "https://appeu.newbook.cloud/*"
  ],
  "optional_host_permissions": [
    "https://admin.hotelnumberfour.com/*",
    "https://n4admindev.pterois.co.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hotel Booking Assistant - Click to open sidepanel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://appeu.newbook.cloud/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
